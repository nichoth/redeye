{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TDVAS2AiqcJoiiTQm1kkLu","type":"tool_result","content":"    return localBranchExists(repoRoot, name) ?\n        `Branch:       would resume ${name}` :\n        `Branch:       would create ${name} from ${current}`\n}\n\nasync function branchExists (\n    repoRoot:string,\n    branchName:string\n):Promise<boolean> {\n    try {\n        await execFileAsync(\n            'git',\n            ['show-ref', '--verify', '--quiet', `refs/heads/${branchName}`],\n            { cwd: repoRoot }\n        )\n        return true\n    } catch {\n        return false\n    }\n}\n\nexport function buildBranchName (\n    repoName:string,\n    ticket:Ticket\n):string {\n    const num = String(ticket.num).padStart(2, '0')\n    const prefix = ticket.feature ?\n        `${ticket.feature}-` :\n        ''\n    return `${repoName}--${prefix}${num}-${ticket.slug}`\n}\n\nasync function removeWorktreeNow (\n    worktreePath:string,\n    opts?:{ force?:boolean }\n):Promise<void> {\n    const args = [\n        '-C', worktreePath,\n        'worktree', 'remove',\n    ]\n    if (opts?.force) args.push('--force')\n    args.push(worktreePath)\n    await execFileAsync('git', args)\n}\n\n// Creates a worktree on a fresh branch, first clearing any stale\n// worktree at the path and any leftover branch of the same name,\n// so re-running after a failed run is safe.\nasync function addWorktreeNow (opts:{\n    repoRoot:string\n    baseBranch:string\n    branchName:string\n    worktreePath:string\n}):Promise<{ worktreePath:string; branchName:string }> {\n    const { repoRoot, baseBranch, branchName, worktreePath } = opts\n\n    if (existsSync(worktreePath)) {\n        try {\n            await execFileAsync(\n                'git',\n                ['worktree', 'remove', '--force', worktreePath],\n                { cwd: repoRoot }\n            )\n        } catch {\n            // directory may not be a registered worktree anymore;\n            // prune stale entries below and let worktree add fail\n            // loudly if the path is still unusable\n        }\n    }\n\n    try {\n        await execFileAsync(\n            'git',\n            ['worktree', 'prune'],\n            { cwd: repoRoot }\n        )\n    } catch {\n        // best-effort cleanup of stale worktree metadata\n    }\n\n    if (await branchExists(repoRoot, branchName)) {\n        await execFileAsync(\n            'git',\n            ['branch', '-D', branchName],\n            { cwd: repoRoot }\n        )\n    }\n\n    await execFileAsync(\n        'git',\n        [\n            'worktree',\n            'add',\n            '-b',\n            branchName,\n            worktreePath,\n            baseBranch,\n        ],\n        { cwd: repoRoot }\n    )\n\n    return { worktreePath, branchName }\n}\n\nlet worktreeQueue:Promise<unknown> = Promise.resolve()\n\n// Serializes every worktree and branch mutation module-wide, so\n// concurrent calls cannot race on shared git refs or on\n// .git/worktrees metadata.\nfunction enqueue<T> (fn:() => Promise<T>):Promise<T> {\n    const result = worktreeQueue.then(fn)\n    worktreeQueue = result.catch(() => {})\n    return result\n}\n\nexport function createWorktree (\n    opts:{\n        repoRoot:string\n        repoName:string\n        baseBranch:string\n        ticket:Ticket\n    }\n):Promise<{ worktreePath:string; branchName:string }> {\n    const { repoRoot, repoName, ticket } = opts\n    const num = String(ticket.num).padStart(2, '0')\n    const prefix = ticket.feature ?\n        `${ticket.feature}-` :\n        ''\n    return enqueue(() => addWorktreeNow({\n        repoRoot,\n        baseBranch: opts.baseBranch,\n        branchName: buildBranchName(repoName, ticket),\n        worktreePath: join(\n            repoRoot,\n            '..',\n            `${repoName}.${prefix}${num}-${ticket.slug}`\n        ),\n    }))\n}\n\n// A worktree that belongs to no ticket, e.g. the review pass:\n// `<repo>.<name>` on branch `<repo>--<name>`. Ticket branches\n// always carry a number, so the names cannot collide.\nexport function createNamedWorktree (\n    opts:{\n        repoRoot:string\n        repoName:string\n        baseBranch:string\n        name:string\n    }\n):Promise<{ worktreePath:string; branchName:string }> {\n    const { repoRoot, repoName, name } = opts\n    return enqueue(() => addWorktreeNow({\n        repoRoot,\n        baseBranch: opts.baseBranch,\n        branchName: `${repoName}--${name}`,\n        worktreePath: join(repoRoot, '..', `${repoName}.${name}`),\n    }))\n}\n\n// Adds a worktree for a branch that already exists, without\n// resetting it. The worktree checks out at the branch's current head.\nasync function addWorktreeForBranchNow (opts:{\n    repoRoot:string\n    branchName:string\n    worktreePath:string\n}):Promise<{ worktreePath:string; branchName:string }> {\n    const { repoRoot, branchName, worktreePath } = opts\n\n    if (existsSync(worktreePath)) {\n        try {\n            await execFileAsync(\n                'git',\n                ['worktree', 'remove', '--force', worktreePath],\n                { cwd: repoRoot }\n            )\n        } catch {\n            // stale entry; prune below\n        }\n    }\n\n    try {\n        await execFileAsync(\n            'git',\n            ['worktree', 'prune'],\n            { cwd: repoRoot }\n        )\n    } catch {\n        // best-effort\n    }\n\n    await execFileAsync(\n        'git',\n        ['worktree', 'add', worktreePath, branchName],\n        { cwd: repoRoot }\n    )\n\n    return { worktreePath, branchName }\n}\n\nexport function addWorktreeForBranch (\n    opts:{\n        repoRoot:string\n        branchName:string\n        worktreePath:string\n    }\n):Promise<{ worktreePath:string; branchName:string }> {\n    return enqueue(() => addWorktreeForBranchNow(opts))\n}\n\nexport function removeWorktree (\n    worktreePath:string,\n    opts?:{ force?:boolean }\n):Promise<void> {\n    return enqueue(() => removeWorktreeNow(worktreePath, opts))\n}\n\n// Deletes a local branch; a missing branch is not an error.\nexport function deleteBranch (\n    repoRoot:string,\n    name:string\n):Promise<void> {\n    return enqueue(async () => {\n        if (!(await branchExists(repoRoot, name))) return\n        await execFileAsync(\n            'git', ['branch', '-D', name], { cwd: repoRoot }\n        )\n    })\n}\n\nexport function hasNewCommits (\n    if (!existsSync(path)) return []\n    return parseReviewEntries(readFileSync(path, 'utf8'))\n}\n\n// ---- Per-ticket review log ----\n\nexport const TICKET_VERDICTS = [\n    'open',\n    'confirmed-fixed',\n    'withdrawn',\n    'still-open',\n] as const\n\nexport type TicketVerdict = typeof TICKET_VERDICTS[number]\n\nexport const TICKET_OUTCOMES = [\n    'pass', 'unresolved', 'failed',\n] as const\n\nexport type TicketOutcome = typeof TICKET_OUTCOMES[number]\n\nexport type FindingWithVerdict = {\n    summary:string\n    detail:string\n    verdict:TicketVerdict\n    fixerResponse?:'fixed'|'disputed'\n    fixerReason?:string\n}\n\nexport type TicketRoundInput = {\n    attempt:number\n    round:number\n    implement:string\n    review:string\n    head:string\n    findings:FindingWithVerdict[]\n    fixHead?:string\n    testResult?:'pass'|'fail'\n}\n\nexport type TicketTerminalInput = {\n    attempt:number\n    outcome:TicketOutcome\n}\n\nexport type TicketRoundEntry = {\n    type:'round'\n    attempt:number\n    round:number\n    implement:string\n    review:string\n    head:string\n    findings:FindingWithVerdict[]\n    fixHead?:string\n    testResult?:'pass'|'fail'\n}\n\nexport type TicketTerminalEntry = {\n    type:'terminal'\n    attempt:number\n    outcome:TicketOutcome\n}\n\nexport type TicketReviewEntry =\n    TicketRoundEntry|TicketTerminalEntry\n\nconst TICKET_SENTINEL_PREFIX = '<!-- redeye:ticket-review'\nconst TICKET_SENTINEL_RE =\n    /^<!-- redeye:ticket-review (.*) -->$/\n\nfunction sanitizeTicket (text:string):string {\n    return text.replace(\n        new RegExp(TICKET_SENTINEL_PREFIX, 'g'),\n        '<!-- redeye-ticket-review'\n    )\n}\n\nfunction encodeAttr (value:string):string {\n    return value\n        .replace(/%/g, '%25')\n        .replace(/\\s/g, c => encodeURIComponent(c))\n}\n\nfunction decodeAttr (value:string):string {\n    try {\n        return decodeURIComponent(value)\n    } catch {\n        return value\n    }\n}\n\nfunction renderFindingWithVerdict (f:FindingWithVerdict):string {\n    const lines:string[] = []\n    const summary = sanitizeTicket(collapse(f.summary))\n    lines.push(`- [${f.verdict}] ${summary}`)\n    if (f.detail) {\n        for (const l of f.detail.split('\\n')) {\n            lines.push(`    ${sanitizeTicket(l)}`)\n        }\n    }\n    if (f.fixerResponse) {\n        const resp = f.fixerResponse === 'disputed' &&\n            f.fixerReason ?\n            `disputed: ${sanitizeTicket(f.fixerReason)}` :\n            f.fixerResponse\n        lines.push(`    fixer: ${resp}`)\n    }\n    return lines.join('\\n')\n}\n\nexport function renderTicketRound (\n    input:TicketRoundInput\n):string {\n    const attrs = [\n        'type=round',\n        `attempt=${input.attempt}`,\n        `round=${input.round}`,\n        `implement=${encodeAttr(input.implement)}`,\n        `review=${encodeAttr(input.review)}`,\n        `head=${input.head}`,\n    ]\n    if (input.fixHead) attrs.push(`fixHead=${input.fixHead}`)\n    if (input.testResult) {\n        attrs.push(`testResult=${input.testResult}`)\n    }\n    const sentinel =\n        `${TICKET_SENTINEL_PREFIX} ${attrs.join(' ')} -->`\n    const findingsBlock = input.findings.length > 0 ?\n        input.findings\n            .map(renderFindingWithVerdict).join('\\n') :\n        NO_FINDINGS\n    return `${sentinel}\\n${findingsBlock}\\n---\\n`\n}\n\nexport function renderTicketTerminal (\n    input:TicketTerminalInput\n):string {\n    const sentinel =\n        `${TICKET_SENTINEL_PREFIX} type=terminal ` +\n        `attempt=${input.attempt} ` +\n        `outcome=${input.outcome} -->`\n    return `${sentinel}\\n---\\n`\n}\n\nfunction isTicketVerdict (v:string):v is TicketVerdict {\n    return (TICKET_VERDICTS as readonly string[]).includes(v)\n}\n\nfunction isTicketOutcome (v:string):v is TicketOutcome {\n    return (TICKET_OUTCOMES as readonly string[]).includes(v)\n}\n\nconst TICKET_FINDING_RE =\n    /^- \\[([^\\]]+)\\]\\s+(.+)$/\n\nfunction parseTicketFindings (\n    lines:string[]\n):FindingWithVerdict[] {\n    const findings:FindingWithVerdict[] = []\n    const details:string[][] = []\n    let fixerResponse:('fixed'|'disputed')|undefined\n    let fixerReason:string|undefined\n\n    const flush = () => {\n        if (findings.length === 0) return\n        const last = findings[findings.length - 1]\n        const d = details[details.length - 1]\n        const plainDetail:string[] = []\n        for (const line of d) {\n            if (line.startsWith('fixer: ')) {\n                const val = line.slice(7)\n                if (val.startsWith('disputed: ')) {\n                    fixerResponse = 'disputed'\n                    fixerReason = val.slice(10)\n                } else if (val === 'fixed' ||\n                    val === 'disputed') {\n                    fixerResponse = val\n                    fixerReason = undefined\n                }\n            } else {\n                plainDetail.push(line)\n            }\n        }\n        last.detail = plainDetail.join('\\n')\n        if (fixerResponse) {\n            last.fixerResponse = fixerResponse\n            if (fixerReason) last.fixerReason = fixerReason\n        }\n    }\n\n    for (const line of lines) {\n        const m = line.match(TICKET_FINDING_RE)\n        if (m) {\n            flush()\n            fixerResponse = undefined\n            fixerReason = undefined\n            const verdict = m[1]\n            if (!isTicketVerdict(verdict)) continue\n            findings.push({\n                summary: collapse(m[2]),\n                detail: '',\n                verdict,\n            })\n            details.push([])\n        } else if (findings.length > 0 && line.trim()) {\n            details[details.length - 1].push(line.trim())\n        }\n    }\n    flush()\n    return findings\n}\n\nfunction parseTicketEntry (\n    sentinel:string,\n    bodyLines:string[]\n):TicketReviewEntry|null {\n    const attrs:Record<string, string> = {}\n    for (const part of sentinel.split(/\\s+/).filter(Boolean)) {\n        const idx = part.indexOf('=')\n        if (idx > 0) {\n            attrs[part.slice(0, idx)] = part.slice(idx + 1)\n        }\n    }\n\n    const { type } = attrs\n    const attemptStr = attrs.attempt\n    if (!attemptStr || !/^\\d+$/.test(attemptStr)) return null\n    const attempt = Number(attemptStr)\n\n    if (type === 'terminal') {\n        const outcome = attrs.outcome\n        if (!outcome || !isTicketOutcome(outcome)) return null\n        return { type: 'terminal', attempt, outcome }\n    }\n\n    if (type === 'round') {\n        const roundStr = attrs.round\n        if (!roundStr || !/^\\d+$/.test(roundStr)) return null\n        const round = Number(roundStr)\n        const head = attrs.head\n        if (!head || !SHA_RE.test(head)) return null\n        const implement = decodeAttr(attrs.implement ?? '')\n        const review = decodeAttr(attrs.review ?? '')\n        if (!implement || !review) return null\n\n        const lines = [...bodyLines]\n        while (lines.length > 0 &&\n            !lines[lines.length - 1].trim()) {\n            lines.pop()\n        }\n        if (lines.length > 0 &&\n            lines[lines.length - 1] === '---') {\n            lines.pop()\n        }\n\n        const findings = parseTicketFindings(lines)\n\n        const entry:TicketRoundEntry = {\n            type: 'round',\n            attempt,\n            round,\n            implement,\n            review,\n            head,\n            findings,\n        }\n\n        const fixHead = attrs.fixHead\n        if (fixHead && SHA_RE.test(fixHead)) {\n            entry.fixHead = fixHead\n        }\n        const testResult = attrs.testResult\n        if (testResult === 'pass' || testResult === 'fail') {\n            entry.testResult = testResult\n        }\n\n        return entry\n    }\n\n    return null\n}\n\nexport function parseTicketReviewLog (\n    text:string\n):TicketReviewEntry[] {\n    const entries:TicketReviewEntry[] = []\n    let sentinel:string|null = null\n    let body:string[] = []\n    const flush = ():void => {\n        if (sentinel === null) return\n        const entry = parseTicketEntry(sentinel, body)\n        if (entry) entries.push(entry)\n    }\n    for (const line of splitLines(text)) {\n        const m = line.match(TICKET_SENTINEL_RE)\n        if (m) {\n            flush()\n            sentinel = m[1]\n            body = []\n        } else if (sentinel !== null) {\n            body.push(line)\n        }\n    }\n    flush()\n    return entries\n}\n\nexport function currentAttemptEntries (\n    entries:ReadonlyArray<TicketReviewEntry>\n):TicketReviewEntry[] {\n    let lastTerminal = -1\n    for (let i = entries.length - 1; i >= 0; i--) {\n        if (entries[i].type === 'terminal') {\n            lastTerminal = i\n            break\n        }\n    }\n    return lastTerminal === -1 ?\n        [...entries] :\n        entries.slice(lastTerminal + 1)\n}\n\nexport function ticketReviewPath (\n    feature:string,\n    ticketFileName:string\n):string {\n    return `.scratch/${feature}/reviews/${ticketFileName}`\n}\n\n// ---- Per-ticket review round runner ----\n\nexport type TicketReviewRoundOpts = {\n    ticket:{ filename:string; body:string; feature:string }\n    specBody:string\n    agentCmd:string\n    model:string|null\n    effort?:EffortLevel\n    maxTurns?:number\n    preferSubagent?:string\n    baseBranch:string\n    worktreePath:string","is_error":false}]},"parent_tool_use_id":null,"session_id":"37a0e722-681e-439b-ad4f-0778a23ce452","uuid":"7e983269-2344-49cc-ad9b-552b5efb8eac","timestamp":"2026-11-21T03:31:12.942Z","tool_use_result":{"stdout":"    return localBranchExists(repoRoot, name) ?\n        `Branch:       would resume ${name}` :\n        `Branch:       would create ${name} from ${current}`\n}\n\nasync function branchExists (\n    repoRoot:string,\n    branchName:string\n):Promise<boolean> {\n    try {\n        await execFileAsync(\n            'git',\n            ['show-ref', '--verify', '--quiet', `refs/heads/${branchName}`],\n            { cwd: repoRoot }\n        )\n        return true\n    } catch {\n        return false\n    }\n}\n\nexport function buildBranchName (\n    repoName:string,\n    ticket:Ticket\n):string {\n    const num = String(ticket.num).padStart(2, '0')\n    const prefix = ticket.feature ?\n        `${ticket.feature}-` :\n        ''\n    return `${repoName}--${prefix}${num}-${ticket.slug}`\n}\n\nasync function removeWorktreeNow (\n    worktreePath:string,\n    opts?:{ force?:boolean }\n):Promise<void> {\n    const args = [\n        '-C', worktreePath,\n        'worktree', 'remove',\n    ]\n    if (opts?.force) args.push('--force')\n    args.push(worktreePath)\n    await execFileAsync('git', args)\n}\n\n// Creates a worktree on a fresh branch, first clearing any stale\n// worktree at the path and any leftover branch of the same name,\n// so re-running after a failed run is safe.\nasync function addWorktreeNow (opts:{\n    repoRoot:string\n    baseBranch:string\n    branchName:string\n    worktreePath:string\n}):Promise<{ worktreePath:string; branchName:string }> {\n    const { repoRoot, baseBranch, branchName, worktreePath } = opts\n\n    if (existsSync(worktreePath)) {\n        try {\n            await execFileAsync(\n                'git',\n                ['worktree', 'remove', '--force', worktreePath],\n                { cwd: repoRoot }\n            )\n        } catch {\n            // directory may not be a registered worktree anymore;\n            // prune stale entries below and let worktree add fail\n            // loudly if the path is still unusable\n        }\n    }\n\n    try {\n        await execFileAsync(\n            'git',\n            ['worktree', 'prune'],\n            { cwd: repoRoot }\n        )\n    } catch {\n        // best-effort cleanup of stale worktree metadata\n    }\n\n    if (await branchExists(repoRoot, branchName)) {\n        await execFileAsync(\n            'git',\n            ['branch', '-D', branchName],\n            { cwd: repoRoot }\n        )\n    }\n\n    await execFileAsync(\n        'git',\n        [\n            'worktree',\n            'add',\n            '-b',\n            branchName,\n            worktreePath,\n            baseBranch,\n        ],\n        { cwd: repoRoot }\n    )\n\n    return { worktreePath, branchName }\n}\n\nlet worktreeQueue:Promise<unknown> = Promise.resolve()\n\n// Serializes every worktree and branch mutation module-wide, so\n// concurrent calls cannot race on shared git refs or on\n// .git/worktrees metadata.\nfunction enqueue<T> (fn:() => Promise<T>):Promise<T> {\n    const result = worktreeQueue.then(fn)\n    worktreeQueue = result.catch(() => {})\n    return result\n}\n\nexport function createWorktree (\n    opts:{\n        repoRoot:string\n        repoName:string\n        baseBranch:string\n        ticket:Ticket\n    }\n):Promise<{ worktreePath:string; branchName:string }> {\n    const { repoRoot, repoName, ticket } = opts\n    const num = String(ticket.num).padStart(2, '0')\n    const prefix = ticket.feature ?\n        `${ticket.feature}-` :\n        ''\n    return enqueue(() => addWorktreeNow({\n        repoRoot,\n        baseBranch: opts.baseBranch,\n        branchName: buildBranchName(repoName, ticket),\n        worktreePath: join(\n            repoRoot,\n            '..',\n            `${repoName}.${prefix}${num}-${ticket.slug}`\n        ),\n    }))\n}\n\n// A worktree that belongs to no ticket, e.g. the review pass:\n// `<repo>.<name>` on branch `<repo>--<name>`. Ticket branches\n// always carry a number, so the names cannot collide.\nexport function createNamedWorktree (\n    opts:{\n        repoRoot:string\n        repoName:string\n        baseBranch:string\n        name:string\n    }\n):Promise<{ worktreePath:string; branchName:string }> {\n    const { repoRoot, repoName, name } = opts\n    return enqueue(() => addWorktreeNow({\n        repoRoot,\n        baseBranch: opts.baseBranch,\n        branchName: `${repoName}--${name}`,\n        worktreePath: join(repoRoot, '..', `${repoName}.${name}`),\n    }))\n}\n\n// Adds a worktree for a branch that already exists, without\n// resetting it. The worktree checks out at the branch's current head.\nasync function addWorktreeForBranchNow (opts:{\n    repoRoot:string\n    branchName:string\n    worktreePath:string\n}):Promise<{ worktreePath:string; branchName:string }> {\n    const { repoRoot, branchName, worktreePath } = opts\n\n    if (existsSync(worktreePath)) {\n        try {\n            await execFileAsync(\n                'git',\n                ['worktree', 'remove', '--force', worktreePath],\n                { cwd: repoRoot }\n            )\n        } catch {\n            // stale entry; prune below\n        }\n    }\n\n    try {\n        await execFileAsync(\n            'git',\n            ['worktree', 'prune'],\n            { cwd: repoRoot }\n        )\n    } catch {\n        // best-effort\n    }\n\n    await execFileAsync(\n        'git',\n        ['worktree', 'add', worktreePath, branchName],\n        { cwd: repoRoot }\n    )\n\n    return { worktreePath, branchName }\n}\n\nexport function addWorktreeForBranch (\n    opts:{\n        repoRoot:string\n        branchName:string\n        worktreePath:string\n    }\n):Promise<{ worktreePath:string; branchName:string }> {\n    return enqueue(() => addWorktreeForBranchNow(opts))\n}\n\nexport function removeWorktree (\n    worktreePath:string,\n    opts?:{ force?:boolean }\n):Promise<void> {\n    return enqueue(() => removeWorktreeNow(worktreePath, opts))\n}\n\n// Deletes a local branch; a missing branch is not an error.\nexport function deleteBranch (\n    repoRoot:string,\n    name:string\n):Promise<void> {\n    return enqueue(async () => {\n        if (!(await branchExists(repoRoot, name))) return\n        await execFileAsync(\n            'git', ['branch', '-D', name], { cwd: repoRoot }\n        )\n    })\n}\n\nexport function hasNewCommits (\n    if (!existsSync(path)) return []\n    return parseReviewEntries(readFileSync(path, 'utf8'))\n}\n\n// ---- Per-ticket review log ----\n\nexport const TICKET_VERDICTS = [\n    'open',\n    'confirmed-fixed',\n    'withdrawn',\n    'still-open',\n] as const\n\nexport type TicketVerdict = typeof TICKET_VERDICTS[number]\n\nexport const TICKET_OUTCOMES = [\n    'pass', 'unresolved', 'failed',\n] as const\n\nexport type TicketOutcome = typeof TICKET_OUTCOMES[number]\n\nexport type FindingWithVerdict = {\n    summary:string\n    detail:string\n    verdict:TicketVerdict\n    fixerResponse?:'fixed'|'disputed'\n    fixerReason?:string\n}\n\nexport type TicketRoundInput = {\n    attempt:number\n    round:number\n    implement:string\n    review:string\n    head:string\n    findings:FindingWithVerdict[]\n    fixHead?:string\n    testResult?:'pass'|'fail'\n}\n\nexport type TicketTerminalInput = {\n    attempt:number\n    outcome:TicketOutcome\n}\n\nexport type TicketRoundEntry = {\n    type:'round'\n    attempt:number\n    round:number\n    implement:string\n    review:string\n    head:string\n    findings:FindingWithVerdict[]\n    fixHead?:string\n    testResult?:'pass'|'fail'\n}\n\nexport type TicketTerminalEntry = {\n    type:'terminal'\n    attempt:number\n    outcome:TicketOutcome\n}\n\nexport type TicketReviewEntry =\n    TicketRoundEntry|TicketTerminalEntry\n\nconst TICKET_SENTINEL_PREFIX = '<!-- redeye:ticket-review'\nconst TICKET_SENTINEL_RE =\n    /^<!-- redeye:ticket-review (.*) -->$/\n\nfunction sanitizeTicket (text:string):string {\n    return text.replace(\n        new RegExp(TICKET_SENTINEL_PREFIX, 'g'),\n        '<!-- redeye-ticket-review'\n    )\n}\n\nfunction encodeAttr (value:string):string {\n    return value\n        .replace(/%/g, '%25')\n        .replace(/\\s/g, c => encodeURIComponent(c))\n}\n\nfunction decodeAttr (value:string):string {\n    try {\n        return decodeURIComponent(value)\n    } catch {\n        return value\n    }\n}\n\nfunction renderFindingWithVerdict (f:FindingWithVerdict):string {\n    const lines:string[] = []\n    const summary = sanitizeTicket(collapse(f.summary))\n    lines.push(`- [${f.verdict}] ${summary}`)\n    if (f.detail) {\n        for (const l of f.detail.split('\\n')) {\n            lines.push(`    ${sanitizeTicket(l)}`)\n        }\n    }\n    if (f.fixerResponse) {\n        const resp = f.fixerResponse === 'disputed' &&\n            f.fixerReason ?\n            `disputed: ${sanitizeTicket(f.fixerReason)}` :\n            f.fixerResponse\n        lines.push(`    fixer: ${resp}`)\n    }\n    return lines.join('\\n')\n}\n\nexport function renderTicketRound (\n    input:TicketRoundInput\n):string {\n    const attrs = [\n        'type=round',\n        `attempt=${input.attempt}`,\n        `round=${input.round}`,\n        `implement=${encodeAttr(input.implement)}`,\n        `review=${encodeAttr(input.review)}`,\n        `head=${input.head}`,\n    ]\n    if (input.fixHead) attrs.push(`fixHead=${input.fixHead}`)\n    if (input.testResult) {\n        attrs.push(`testResult=${input.testResult}`)\n    }\n    const sentinel =\n        `${TICKET_SENTINEL_PREFIX} ${attrs.join(' ')} -->`\n    const findingsBlock = input.findings.length > 0 ?\n        input.findings\n            .map(renderFindingWithVerdict).join('\\n') :\n        NO_FINDINGS\n    return `${sentinel}\\n${findingsBlock}\\n---\\n`\n}\n\nexport function renderTicketTerminal (\n    input:TicketTerminalInput\n):string {\n    const sentinel =\n        `${TICKET_SENTINEL_PREFIX} type=terminal ` +\n        `attempt=${input.attempt} ` +\n        `outcome=${input.outcome} -->`\n    return `${sentinel}\\n---\\n`\n}\n\nfunction isTicketVerdict (v:string):v is TicketVerdict {\n    return (TICKET_VERDICTS as readonly string[]).includes(v)\n}\n\nfunction isTicketOutcome (v:string):v is TicketOutcome {\n    return (TICKET_OUTCOMES as readonly string[]).includes(v)\n}\n\nconst TICKET_FINDING_RE =\n    /^- \\[([^\\]]+)\\]\\s+(.+)$/\n\nfunction parseTicketFindings (\n    lines:string[]\n):FindingWithVerdict[] {\n    const findings:FindingWithVerdict[] = []\n    const details:string[][] = []\n    let fixerResponse:('fixed'|'disputed')|undefined\n    let fixerReason:string|undefined\n\n    const flush = () => {\n        if (findings.length === 0) return\n        const last = findings[findings.length - 1]\n        const d = details[details.length - 1]\n        const plainDetail:string[] = []\n        for (const line of d) {\n            if (line.startsWith('fixer: ')) {\n                const val = line.slice(7)\n                if (val.startsWith('disputed: ')) {\n                    fixerResponse = 'disputed'\n                    fixerReason = val.slice(10)\n                } else if (val === 'fixed' ||\n                    val === 'disputed') {\n                    fixerResponse = val\n                    fixerReason = undefined\n                }\n            } else {\n                plainDetail.push(line)\n            }\n        }\n        last.detail = plainDetail.join('\\n')\n        if (fixerResponse) {\n            last.fixerResponse = fixerResponse\n            if (fixerReason) last.fixerReason = fixerReason\n        }\n    }\n\n    for (const line of lines) {\n        const m = line.match(TICKET_FINDING_RE)\n        if (m) {\n            flush()\n            fixerResponse = undefined\n            fixerReason = undefined\n            const verdict = m[1]\n            if (!isTicketVerdict(verdict)) continue\n            findings.push({\n                summary: collapse(m[2]),\n                detail: '',\n                verdict,\n            })\n            details.push([])\n        } else if (findings.length > 0 && line.trim()) {\n            details[details.length - 1].push(line.trim())\n        }\n    }\n    flush()\n    return findings\n}\n\nfunction parseTicketEntry (\n    sentinel:string,\n    bodyLines:string[]\n):TicketReviewEntry|null {\n    const attrs:Record<string, string> = {}\n    for (const part of sentinel.split(/\\s+/).filter(Boolean)) {\n        const idx = part.indexOf('=')\n        if (idx > 0) {\n            attrs[part.slice(0, idx)] = part.slice(idx + 1)\n        }\n    }\n\n    const { type } = attrs\n    const attemptStr = attrs.attempt\n    if (!attemptStr || !/^\\d+$/.test(attemptStr)) return null\n    const attempt = Number(attemptStr)\n\n    if (type === 'terminal') {\n        const outcome = attrs.outcome\n        if (!outcome || !isTicketOutcome(outcome)) return null\n        return { type: 'terminal', attempt, outcome }\n    }\n\n    if (type === 'round') {\n        const roundStr = attrs.round\n        if (!roundStr || !/^\\d+$/.test(roundStr)) return null\n        const round = Number(roundStr)\n        const head = attrs.head\n        if (!head || !SHA_RE.test(head)) return null\n        const implement = decodeAttr(attrs.implement ?? '')\n        const review = decodeAttr(attrs.review ?? '')\n        if (!implement || !review) return null\n\n        const lines = [...bodyLines]\n        while (lines.length > 0 &&\n            !lines[lines.length - 1].trim()) {\n            lines.pop()\n        }\n        if (lines.length > 0 &&\n            lines[lines.length - 1] === '---') {\n            lines.pop()\n        }\n\n        const findings = parseTicketFindings(lines)\n\n        const entry:TicketRoundEntry = {\n            type: 'round',\n            attempt,\n            round,\n            implement,\n            review,\n            head,\n            findings,\n        }\n\n        const fixHead = attrs.fixHead\n        if (fixHead && SHA_RE.test(fixHead)) {\n            entry.fixHead = fixHead\n        }\n        const testResult = attrs.testResult\n        if (testResult === 'pass' || testResult === 'fail') {\n            entry.testResult = testResult\n        }\n\n        return entry\n    }\n\n    return null\n}\n\nexport function parseTicketReviewLog (\n    text:string\n):TicketReviewEntry[] {\n    const entries:TicketReviewEntry[] = []\n    let sentinel:string|null = null\n    let body:string[] = []\n    const flush = ():void => {\n        if (sentinel === null) return\n        const entry = parseTicketEntry(sentinel, body)\n        if (entry) entries.push(entry)\n    }\n    for (const line of splitLines(text)) {\n        const m = line.match(TICKET_SENTINEL_RE)\n        if (m) {\n            flush()\n            sentinel = m[1]\n            body = []\n        } else if (sentinel !== null) {\n            body.push(line)\n        }\n    }\n    flush()\n    return entries\n}\n\nexport function currentAttemptEntries (\n    entries:ReadonlyArray<TicketReviewEntry>\n):TicketReviewEntry[] {\n    let lastTerminal = -1\n    for (let i = entries.length - 1; i >= 0; i--) {\n        if (entries[i].type === 'terminal') {\n            lastTerminal = i\n            break\n        }\n    }\n    return lastTerminal === -1 ?\n        [...entries] :\n        entries.slice(lastTerminal + 1)\n}\n\nexport function ticketReviewPath (\n    feature:string,\n    ticketFileName:string\n):string {\n    return `.scratch/${feature}/reviews/${ticketFileName}`\n}\n\n// ---- Per-ticket review round runner ----\n\nexport type TicketReviewRoundOpts = {\n    ticket:{ filename:string; body:string; feature:string }\n    specBody:string\n    agentCmd:string\n    model:string|null\n    effort?:EffortLevel\n    maxTurns?:number\n    preferSubagent?:string\n    baseBranch:string\n    worktreePath:string","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01TDVAS2AiqcJoiiTQm1kkLu","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
