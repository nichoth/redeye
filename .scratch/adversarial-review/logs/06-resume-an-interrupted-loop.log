mentStr:\n                        'mock-agent-review',\n                    reviewStr: 'pi',\n                    review: { provider: FAKE_PI },\n                    maxRounds: 3,\n                    minRounds: 1,\n                },\n            }\n        )\n        t.ok(result.allDone,\n            'ticket passes (fresh start)')\n\n        // Implementation ran again\n        const roles = countRoles(h.recordDir)\n        t.equal(roles.ticket, 1,\n            'ticket agent ran (fresh start)')\n    })\n    rmSync(piRecDir, {\n        recursive: true, force: true,\n    })\n})\n\ntest('resume - log ends in terminal ' +\n    'starts fresh', async t => {\n    const piRecDir = mkdtempSync(\n        join(tmpdir(), 'redeye-pirec-')\n    )\n    const counterFile = join(piRecDir, 'counter')\n    await withHarness({\n        MOCK_TICKET: 'pass',\n        FAKE_PI_RECORD_DIR: piRecDir,","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01EsGcqCZzqsXyyLdgikqFE9","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
