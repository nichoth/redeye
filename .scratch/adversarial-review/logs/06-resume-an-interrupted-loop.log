LI subprocess - AC3.1 nothing ready stops before any branch ' +\n    'work', async t => {\n    const { projectDir, issuesDir, templateDir } =\n        twoFeatureRepo(BLOCKED_BODY, 'ready-for-agent')\n    try {\n        const { code, stdout } = await spawnCli([\n            MOCK_AGENT, '--spec', FEAT,\n        ], { cwd: projectDir })\n\n        t.equal(code, 0, 'exit 0')\n        t.ok(stdout.includes('other-feat/01'), 'names the blocker')\n        t.equal(integrationBranches(projectDir), '', 'no new branch')\n        t.equal(headBranch(projectDir), 'main', 'still on main')\n        rmSync(projectDir, { recursive: true, force: true })\n    }\n})\n\n// --- Running with the implement and review roles ---\n\nconst FAKE_PI = join(process.cwd(), 'test', 'fake-pi', 'pi')\nconst FAKE_PI_KEYS = [\n    'FAKE_PI_RECORD_DIR',\n    'FAKE_PI_RESPONSES',\n    'FAKE_PI_COUNTER',\n    'FAKE_PI_DELEGATE',\n]\n\n// fakeClaudeEnv without the fake pi keys either, plus `extra`\nfunction rolesEnv (\n    extra:Record<string, string> = {}\n):NodeJS.ProcessEnv {\n    const env = fakeClaudeEnv()\n    for (const key of FAKE_PI_KEYS) delete env[key]\n    return { ...env, ...extra }\n}\n\nfunction readArgvLog (file:string):string[][] {\n    return readFileSync(file, 'utf8')\n        .split('\\n')\n        .filter(line => line !== '')\n        .map(line => JSON.parse(line) as string[])\n}\n\nfunction readPiRecords (dir:string):{ model:string|null }[] {\n    return readdirSync(dir).map(name => {\n        return JSON.parse(\n            readFileSync(join(dir, name), 'utf8')\n        ) as { model:string|null }\n    })\n}\n\n// The value after `flag` in an argv list, or undefined\nfunction flagValue (argv:string[], flag:string):string|undefined {\n    const i = argv.indexOf(flag)\n    return i === -1 ? undefined : argv[i + 1]\n}\n\ntest('CLI subprocess - bare redeye runs tickets with the ' +\n    'implement role; role flags win, CLI flags fill in',\ntest/mock-agent-claude.js:68:    if (process.env.FAK