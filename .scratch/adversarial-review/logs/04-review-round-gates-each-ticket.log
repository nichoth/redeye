)\n        writeFileSync(\n            join(process.cwd(), '.redeye', 'findings.md'),\n            '- [withdrawn] mock finding from pi\\n'\n        )\n    } else if (response === 'verdict-open') {\n        mkdirSync(\n            join(process.cwd(), '.redeye'),\n            { recursive: true }\n        )\n        writeFileSync(\n            join(process.cwd(), '.redeye', 'findings.md'),\n            '- [still-open] mock finding from pi\\n'\n        )\n    }\n} else {\n    const delegate = process.env.FAKE_PI_DELEGATE\n    if (delegate) {\n        const r = spawnSync(\n            process.execPath,\n            [delegate, ...args],\n            {\n                input: prompt,\n                stdio: ['pipe', 'inherit', 'inherit'],\n                cwd: process.cwd(),\n            }\n        )\n        process.exitCode = r.status ?? 1\n    }\n}\n7246:const FAKE_PI = join(process.cwd(), 'test', 'fake-pi', 'pi')\n7247:const FAKE_PI_KEYS = [\n7248:    'FAKE_PI_RECORD_DIR',\n7249:    'FAKE_PI_RESPONSES',\n7250:    'FAKE_PI_COUNTER',\n7251:    'FAKE_PI_DELEGATE',\n7259:    for (const key of FAKE_PI_KEYS) delete env[key]\n7299:                    review: FAKE_PI,\n7321:                FAKE_PI_RECORD_DIR: recordDir,\n7322:                FAKE_PI_RESPONSES: 'clean',\n7323:                FAKE_PI_COUNTER: join(logDir, 'counter'),\n7360:                    review: FAKE_PI,\n7379:                FAKE_PI_RESPONSES: 'clean',\n7380:                FAKE_PI_COUNTER: join(logDir, 'counter'),","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01YYxt81757LyYRZXbBKSC4C","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
