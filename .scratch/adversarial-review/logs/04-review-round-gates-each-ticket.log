{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LcGyYR5Xv6qnLgmFGR8QS4","type":"tool_result","content":"#!/usr/bin/env node\nimport { execSync } from 'node:child_process'\nimport { writeFileSync } from 'node:fs'\nimport { join } from 'node:path'\nimport { randomUUID } from 'node:crypto'\n\nconst GIT_ENV = {\n    ...process.env,\n    GIT_COMMITTER_NAME:'Mock Agent',\n    GIT_COMMITTER_EMAIL:'mock@example.com',\n    GIT_AUTHOR_NAME:'Mock Agent',\n    GIT_AUTHOR_EMAIL:'mock@example.com',\n}\n\n// Multiple mock agents may run concurrently against the same\n// working tree in in-place (non-worktree) test scenarios, so\n// retry the add+commit pair past transient index/ref lock\n// contention from sibling processes.\nfunction commitFileWithRetry (filename) {\n    let lastErr\n    for (let attempt = 0; attempt < 50; attempt++) {\n        try {\n            execSync(`git add ${filename}`, {\n                stdio:'ignore', env:GIT_ENV,\n            })\n            execSync(\n                'git commit -m \"mock agent change\" --no-verify',\n                { stdio:'pipe', env:GIT_ENV }\n            )\n            return\n        } catch (err) {\n            // A sibling process may have already committed this\n            // file (it stages whatever is in the index, not just\n            // its own write) -- that counts as success here.\n            const msg = String(err.stderr || err)\n            if (msg.includes('nothing to commit')) return\n            lastErr = err\n            const until = Date.now() + 20 + Math.random() * 30\n            while (Date.now() < until) { /* busy-wait */ }\n        }\n    }\n    throw lastErr\n}\n\nprocess.stdin.resume()\nprocess.stdin.on('end', () => {\n    try {\n        const filename = `mock-agent-change-${randomUUID()}.txt`\n        writeFileSync(\n            join(process.cwd(), filename),\n            String(Date.now())\n        )\n        commitFileWithRetry(filename)\n    } catch {\n        // not inside a git repo; nothing to verify against\n    }\n    process.exit(0)\n})\n27:export function getCurrentBranch (cwd?:string):string {\n36:export function localBranchExists (\n54:export function getDefaultBranch (repoRoot:string):string|null {\n81:export function integrationBranchName (\n93:export function planIntegrationBranch (\n127:export function prepareIntegrationBranch (\n191:export function describeIntegrationBranch (\n221:export function buildBranchName (\n400:export function addWorktreeForBranch (\n418:export function deleteBranch (\n292:function scratchDirs (projectDir:string):{\n293-    issuesDir:string\n294-    specPath:string\n295-    logsDir:string\n296-} {\n297-    const base = join(\n298-        projectDir, '.scratch', FEAT\n299-    )\n300-    const issuesDir = join(base, 'issues')\n301-    const specPath = join(base, 'spec.md')\n302-    const logsDir = join(base, 'logs')\n303-    mkdirSync(issuesDir, { recursive: true })\n304-    writeFileSync(specPath, '# Test spec')\n305-    return { issuesDir, specPath, logsDir }\n306-}\n307-\n290:const FEAT = 'test-feat'","is_error":false}]},"parent_tool_use_id":null,"session_id":"e10e1272-8092-416a-9383-32ab4ddab6c8","uuid":"69671d9e-2306-4365-aa02-7e17c25f490c","timestamp":"2026-11-21T03:10:01.629Z","tool_use_result":{"stdout":"#!/usr/bin/env node\nimport { execSync } from 'node:child_process'\nimport { writeFileSync } from 'node:fs'\nimport { join } from 'node:path'\nimport { randomUUID } from 'node:crypto'\n\nconst GIT_ENV = {\n    ...process.env,\n    GIT_COMMITTER_NAME:'Mock Agent',\n    GIT_COMMITTER_EMAIL:'mock@example.com',\n    GIT_AUTHOR_NAME:'Mock Agent',\n    GIT_AUTHOR_EMAIL:'mock@example.com',\n}\n\n// Multiple mock agents may run concurrently against the same\n// working tree in in-place (non-worktree) test scenarios, so\n// retry the add+commit pair past transient index/ref lock\n// contention from sibling processes.\nfunction commitFileWithRetry (filename) {\n    let lastErr\n    for (let attemp