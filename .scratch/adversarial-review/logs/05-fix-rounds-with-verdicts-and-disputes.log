d once, not retried')","+        t.equal(roles.filter(r => r === 'fixer').length, 1,","+            'the fixer runs after round 1 only')","+","+        const integration = integrationBranches(projectDir)","+        const body = gitOut(projectDir, [","+            'show', `${integration}:.scratch/${FEAT}/issues/01-task.md`,","+        ])","+        t.equal(/\\*\\*Status:\\*\\*\\s*(\\S+)/.exec(body)?.[1],","+            'ready-for-human', 'the ticket is ready-for-human')","+","+        const changed = gitOut(projectDir, [","+            'log', integration, '--name-only', '--format=',","+        ])","+        t.ok(!changed.includes('mock-change-'),","+            'the ticket change is not merged')","+        const branches = gitOut(projectDir, [","+            'branch', '--list', '--format=%(refname:short)',","+        ]).split('\\n')","+        t.ok(branches.some(b => b.includes('01-task') &&","+            b !== integration), 'the ticket branch is kept')","+","+        const entries = parseTicketReviewLog(gitOut(projectDir, [","+            'show',","+            `${integration}:${ticketReviewPath(FEAT, '01-task.md')}`,","+        ]))","+        const rounds = entries.filter(","+            e => e.type === 'round'","+        ) as TicketRoundEntry[]","+        t.equal(rounds.length, 2, 'the log has both rounds')","+        t.equal(rounds[0]?.findings[0]?.fixerResponse, 'disputed',","+            'round 1 records the dispute')","+        t.equal(rounds[1]?.findings[0]?.verdict, 'still-open',","+            'round 2 keeps the finding open')","+        const last = entries[entries.length - 1]","+        t.ok(last?.type === 'terminal' &&","+            last.outcome === 'unresolved', 'the loop ends unresolved')","+    } finally {","+        removeWorktreesAndRepo(projectDir)","+        rmSync(logDir, { recursive: true, force: true })","+        rmSync(recordDir, { recursive: true, force: true })","+        rmSync(templateDir, { recursive: true, force: true })","+    }","+}