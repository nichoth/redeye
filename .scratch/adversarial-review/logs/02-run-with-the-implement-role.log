d the\n// same model. A role with no model runs its provider's default.\nexport function sameModel (a:ParsedRole, b:ParsedRole):boolean {\n    return basename(a.provider) === basename(b.provider) &&\n        (a.model ?? '') === (b.model ?? '')\n}\n\nexport interface AdversarialConfig {","originalFile":"import { readFileSync, existsSync } from 'node:fs'\nimport { join } from 'node:path'\nimport yargs from 'yargs'\nimport { ALL_EFFORT_LEVELS } from './retry.js'\n\nexport interface RoleStringOptions {\n    alias?:string\n    type:'string'|'number'|'boolean'\n    choices?:readonly string[]\n    describe?:string\n}\n\nexport const ROLE_OPTIONS:{\n    [key:string]:RoleStringOptions\n} = {\n    m: {\n        alias: 'model',\n        type: 'string',\n        describe: 'Model passed to the agent',\n    },\n    effort: {\n        type: 'string',\n        choices: ALL_EFFORT_LEVELS as unknown as string[],\n        describe: 'Starting effort level',\n    },\n    'max-turns': {\n        type: 'number',\n        describe: 'Max agentic turns per ticket',\n    },\n    'prefer-subagent': {\n        type: 'string',\n        describe: 'Model that subagents default to',\n    },\n} as const\n\nexport interface ParsedRole {\n    provider:string\n    model?:string\n    effort?:string\n    maxTurns?:number\n    preferSubagent?:string\n}\n\nexport function parseRoleString (input:string):ParsedRole {\n    const trimmed = input.trim()\n    if (trimmed === '') {\n        throw new Error('Role string is empty')\n    }\n\n    const args = trimmed.split(/\\s+/)\n\n    const parsed = yargs(args)\n        .command(\n            '$0 <provider>',\n            false,\n            y => y.positional('provider', {\n                type: 'string',\n                demandOption: true,\n            })\n        )\n        .strict()\n        .strictCommands(false)\n        .option('m', ROLE_OPTIONS.m)\n        .option('effort', ROLE_OPTIONS.effort)\n        .option('max-turns', ROLE_OPTIONS['max-turns'])\n        .option(\n            'prefer-subagent',\n            ROLE_OPTIONS['prefer-subagent']\n        )\n        .help(false)\n        .version(false)\n        .exitProcess(false)\n        .fail((msg:string|null, err:unknown) => {\n            const message = msg ??\n                (err instanceof Error ? err.message : String(err))\n            throw new Error(message)\n        })\n        .parseSync()\n\n    const positionals = parsed._ as (string|number)[]\n    if (positionals.length > 0) {\n        throw new Error(\n            'Extra positional argument: ' +\n            `\"${positionals.join(' ')}\"`\n        )\n    }\n\n    const provider = parsed.provider as string\n\n    const rawSubagent = parsed.preferSubagent as\n        string|undefined\n    const preferSubagent = rawSubagent === '' ?\n        'true' :\n        rawSubagent || undefined\n\n    return {\n        provider,\n        model: parsed.model as string|undefined,\n        effort: parsed.effort as string|undefined,\n        maxTurns: parsed.maxTurns as number|undefined,\n        preferSubagent,\n    }\n}\n\nexport interface CliOptions {\n    model?:string\n    effort?:string\n    maxTurns?:number\n    preferSubagent?:string\n}\n\n// Merges a parsed role with CLI options. The role's flags\n// win; CLI fills in whatever the role leaves out.\nexport function mergeRoleWithCli (\n    role:ParsedRole,\n    cli:CliOptions\n):ParsedRole {\n    return {\n        provider: role.provider,\n        model: role.model ?? cli.model,\n        effort: role.effort ?? cli.effort,\n        maxTurns: role.maxTurns ?? cli.maxTurns,\n        preferSubagent: role.preferSubagent ??\n            cli.preferSubagent,\n    }\n}\n\nexport interface AdversarialConfig {\n    implement:ParsedRole\n    review:ParsedRole\n    implementStr:string\n    reviewStr:string\n    maxRounds:number\n    minRounds:number\n}\n\nfunction isPositiveInteger (v:unknown):v is number {\n    return typeof v === 'number' &&\n        Number.isInteger(v) &&\n        v > 0\n}\n\nfunction isPlainObject (\n    v:unknown\n):v is Record<string, unknown> {\n    return v !== null && typeof v === 'object' && !Array.isArray(v)\n}\n\n// Reads .redeye.json from `root`. Returns null when the file\n// is absent or has no adversarial key (loop off). Throws on\n// any validation error so the caller can exit before work\n// starts.\nexport function loadConfig (\n    root:string\n):AdversarialConfig|null {\n    const file = join(root, '.redeye.json')\n    if (!existsSync(file)) return null\n\n    let raw:unknown\n    try {\n        raw = JSON.parse(readFileSync(file, 'utf8'))\n    } catch (err) {\n        const msg = err instanceof Error ?\n            err.message :\n            String(err)\n        throw new Error(\n            `.redeye.json: ${msg}`\n        )\n    }\n\n    if (!isPlainObject(raw)) {\n        throw new Error('.redeye.json: must be a JSON object')\n    }\n    if (!('adversarial' in raw)) return null\n\n    const adv = raw.adversarial\n    if (!isPlainObject(adv)) {\n        throw new Error(\n            '.redeye.json: adversarial must be an object ' +\n            'with implement and review role strings'\n        )\n    }\n\n    if (typeof adv.implement !== 'string') {\n        throw new Error(\n            '.redeye.json: adversarial.implement is ' +\n            'required (a role string)'\n        )\n    }\n    if (typeof adv.review !== 'string') {\n        throw new Error(\n            '.redeye.json: adversarial.review is ' +\n            'required (a role string)'\n        )\n    }\n\n    const implement = parseRoleString(adv.implement)\n    const review = parseRoleString(adv.review)\n\n    const maxRounds = adv.maxRounds ?? 3\n    const minRounds = adv.minRounds ?? 1\n\n    if (!isPositiveInteger(maxRounds)) {\n        throw new Error(\n            '.redeye.json: maxRounds must be a ' +\n            'positive integer'\n        )\n    }\n    if (!isPositiveInteger(minRounds)) {\n        throw new Error(\n            '.redeye.json: minRounds must be a ' +\n            'positive integer'\n        )\n    }\n    if (minRounds > maxRounds) {\n        throw new Error(\n            '.redeye.json: minRounds (' + minRounds +\n            ') must not exceed maxRounds (' +\n            maxRounds + ')'\n        )\n    }\n\n    return {\n        implement,\n        review,\n        implementStr: adv.implement as string,\n        reviewStr: adv.review as string,\n        maxRounds,\n        minRounds,\n    }\n}\n","structuredPatch":[{"oldStart":125,"oldLines":6,"newStart":125,"newLines":56,"lines":["     }"," }"," ","+export interface ResolvedRoles {","+    // the role that implements tickets in this run","+    implement:ParsedRole","+    // null when .redeye.json has no adversarial key","+    review:ParsedRole|null","+    // true when a command-line provider replaced `implement`","+    overridden:boolean","+}","+","+// The effective roles for a run. A command-line provider replaces","+// the whole implement role, so its flags do not carry over; with","+// no provider, `implement` is used. Each role's own flags win and","+// the CLI flags fill in the rest. Throws when there is neither a","+// provider nor a config.","+export function resolveRoles (","+    cliProvider:string|undefined,","+    cli:CliOptions,","+    adv:AdversarialConfig|null","+):ResolvedRoles {","+    const review = adv ? mergeRoleWithCli(adv.review, cli) : null","+    if (cliProvider) {","+        return {","+            implement: mergeRoleWithCli(","+                { provider: cliProvider },","+                cli","+            ),","+            review,","+            overridden: adv !== null,","+        }","+    }","+    if (!adv) {","+        throw new Error(","+            'Specify a provider (e.g. redeye claude) ' +","+            'or set implement in .redeye.json'","+        )","+    }","+    return {","+        implement: mergeRoleWithCli(adv.implement, cli),","+        review,","+        overridden: false,","+    }","+}","+","+// True when two roles run the same provider (by basename) and the","+// same model. A role with no model runs its provider's default.","+export function sameModel (a:ParsedRole, b:ParsedRole):boolean {","+    return basename(a.provider) === basename(b.provider) &&","+        (a.model ?? '') === (b.model ?? '')","+}","+"," export interface AdversarialConfig {","     implement:ParsedRole","     review:ParsedRole"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true},"tool_result_meta":[{"id":"toolu_014WFPK4LMAUyCEwAcHonKGu","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
